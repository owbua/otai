{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kochbuch-rezept/1",
  "title": "Kochbuch-Rezept",
  "description": "Austauschformat der Android-App „Mein Kochbuch“. Eine Datei enthält ein Rezept-Objekt oder ein Array davon.",
  "oneOf": [
    { "$ref": "#/$defs/recipe" },
    { "type": "array", "items": { "$ref": "#/$defs/recipe" }, "minItems": 1 }
  ],
  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["format", "title", "servings", "ingredients", "steps"],
      "properties": {
        "format": { "const": "kochbuch-rezept/1" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stabile ID, z. B. Slug des Titels. Gleiche ID beim Import → Rückfrage Ersetzen/Kopie." },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "servings": { "type": "integer", "minimum": 1, "description": "Portionen, für die alle Mengen gelten" },
        "category": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": ["string", "null"], "enum": ["Einfach", "Normal", "Aufwendig", null] },
        "times": {
          "type": "object",
          "properties": {
            "totalMin": { "type": ["integer", "null"] },
            "activeMin": { "type": ["integer", "null"] },
            "cookMin": { "type": ["integer", "null"] }
          }
        },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "tips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": { "title": { "type": ["string", "null"] }, "text": { "type": "string" } }
          }
        },
        "nutrition": {
          "type": ["object", "null"],
          "description": "Pro Portion",
          "properties": {
            "kcal": { "type": ["number", "null"] },
            "proteinG": { "type": ["number", "null"] },
            "fatG": { "type": ["number", "null"] },
            "carbsG": { "type": ["number", "null"] }
          }
        },
        "source": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "author": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] }
          }
        },
        "favorite": { "type": "boolean", "description": "Von der App verwaltet" },
        "rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "Von der App verwaltet" },
        "cookedCount": { "type": "integer", "description": "Von der App verwaltet" },
        "lastCooked": { "type": ["string", "null"], "format": "date", "description": "Von der App verwaltet" },
        "notes": {
          "type": "array",
          "description": "Von der App verwaltet (Rückmeldungen nach dem Kochen)",
          "items": {
            "type": "object",
            "required": ["date"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "text": { "type": "string" },
              "changes": { "type": "array", "items": { "type": "string" } },
              "rating": { "type": ["integer", "null"] }
            }
          }
        },
        "photo": { "type": ["string", "null"], "description": "Nur im ZIP-Backup: Dateiname unter fotos/" },
        "createdAt": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Eindeutig im Rezept; Schritte verweisen darauf" },
        "amount": { "type": ["number", "null"], "description": "null = nach Belieben" },
        "unit": { "type": ["string", "null"], "description": "g, kg, ml, l, EL, TL, Prise, Bund, Dose, Pck., Zehe(n) … – null bei Stückzahl" },
        "name": { "type": "string" },
        "note": { "type": ["string", "null"], "description": "Zusatz wie „ca. 150 g“, „aus der Dose“" },
        "group": { "type": ["string", "null"], "description": "Optionale Gruppe, z. B. „Für die Sauce“" }
      }
    },
    "step": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "ingredients": { "type": "array", "items": { "type": "string" }, "description": "Keys der Zutaten, die in diesem Schritt verarbeitet werden" },
        "timer": {
          "type": ["object", "null"],
          "required": ["seconds"],
          "properties": {
            "seconds": { "type": "integer", "minimum": 1 },
            "label": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
